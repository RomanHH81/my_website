{
  "name": "Primaflow · Lead-Handling (Webhook → DB + Mail + Auto-Reply)",
  "description": "Wird vom primaflow.de-Kontaktformular gefeuert (POST /api/contact → Webhook-Node). Legt den Lead in Postgres ab, schickt primaflow eine interne Benachrichtigung und dem Absender eine Bestätigungs-Mail. Credentials heißen exakt 'Primaflow Postgres' und 'Primaflow SMTP' — siehe n8n/README.md für Setup.",
  "nodes": [
    {
      "id": "webhook-lead",
      "type": "n8n-nodes-base.webhook",
      "name": "Primaflow Webhook",
      "typeVersion": 1,
      "position": [240, 320],
      "webhookId": "primaflow-lead",
      "parameters": {
        "httpMethod": "POST",
        "path": "primaflow-lead",
        "responseMode": "lastNode",
        "responseData": "allEntries",
        "options": {}
      }
    },
    {
      "id": "set-normalize",
      "type": "n8n-nodes-base.set",
      "name": "Normalisieren",
      "typeVersion": 3.4,
      "position": [480, 320],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "a-name", "name": "name", "value": "={{ $json.body.name }}", "type": "string" },
            { "id": "a-email", "name": "email", "value": "={{ $json.body.email }}", "type": "string" },
            { "id": "a-interest", "name": "interest", "value": "={{ $json.body.interest }}", "type": "string" },
            { "id": "a-message", "name": "message", "value": "={{ $json.body.message }}", "type": "string" },
            { "id": "a-source", "name": "source", "value": "={{ $json.body.source }}", "type": "string" },
            { "id": "a-submitted-at", "name": "submittedAt", "value": "={{ $json.body.submittedAt }}", "type": "string" },
            { "id": "a-user-agent", "name": "userAgent", "value": "={{ $json.body.userAgent }}", "type": "string" },
            { "id": "a-referer", "name": "referer", "value": "={{ $json.body.referer }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "postgres-insert",
      "type": "n8n-nodes-base.postgres",
      "name": "Postgres: Insert Lead",
      "typeVersion": 2.4,
      "position": [720, 320],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (name, email, interest, message, source, submitted_at, user_agent, referer) VALUES ({{ $json.name }}, {{ $json.email }}, {{ $json.interest }}, {{ $json.message }}, {{ $json.source }}, {{ $json.submittedAt }}, {{ $json.userAgent }}, {{ $json.referer }}) RETURNING id;",
        "options": {
          "queryReplacement": "={{ $json }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "primaflow-postgres",
          "name": "Primaflow Postgres"
        }
      }
    },
    {
      "id": "email-internal",
      "type": "n8n-nodes-base.emailSend",
      "name": "Mail an primaflow",
      "typeVersion": 2.1,
      "position": [960, 200],
      "parameters": {
        "fromEmail": "noreply@primaflow.de",
        "toEmail": "info@primaflow.de",
        "subject": "=Neue Anfrage über primaflow.de — {{ $json.name }}",
        "html": "=<h2 style=\"font-family:system-ui;color:#1a1a1a\">Neue Anfrage über primaflow.de</h2>\n<table style=\"font-family:system-ui;border-collapse:collapse;width:100%;max-width:560px\">\n  <tr><td style=\"padding:6px 12px;color:#666;width:120px\">Name</td><td style=\"padding:6px 12px\"><b>{{ $json.name }}</b></td></tr>\n  <tr style=\"background:#fafafa\"><td style=\"padding:6px 12px;color:#666\">E-Mail</td><td style=\"padding:6px 12px\"><a href=\"mailto:{{ $json.email }}\">{{ $json.email }}</a></td></tr>\n  <tr><td style=\"padding:6px 12px;color:#666\">Interesse</td><td style=\"padding:6px 12px\">{{ $json.interest }}</td></tr>\n  <tr style=\"background:#fafafa\"><td style=\"padding:6px 12px;color:#666;vertical-align:top\">Nachricht</td><td style=\"padding:6px 12px;white-space:pre-wrap\">{{ $json.message }}</td></tr>\n  <tr><td style=\"padding:6px 12px;color:#666\">Quelle</td><td style=\"padding:6px 12px\"><code>{{ $json.source }}</code></td></tr>\n  <tr style=\"background:#fafafa\"><td style=\"padding:6px 12px;color:#666\">Zeit</td><td style=\"padding:6px 12px\"><code>{{ $json.submittedAt }}</code></td></tr>\n</table>\n<hr style=\"margin:24px 0;border:none;border-top:1px solid #eee\">\n<p style=\"font-family:system-ui;color:#999;font-size:12px\">userAgent: {{ $json.userAgent }}<br>referer: {{ $json.referer }}</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "primaflow-smtp",
          "name": "Primaflow SMTP"
        }
      }
    },
    {
      "id": "email-auto-reply",
      "type": "n8n-nodes-base.emailSend",
      "name": "Auto-Reply an Absender",
      "typeVersion": 2.1,
      "position": [960, 440],
      "parameters": {
        "fromEmail": "noreply@primaflow.de",
        "toEmail": "={{ $json.email }}",
        "subject": "Danke für deine Anfrage — ich melde mich innerhalb 24h",
        "html": "=<div style=\"font-family:system-ui;max-width:560px;margin:0 auto;padding:24px;color:#1a1a1a\">\n  <h2 style=\"margin:0 0 16px\">Hi {{ $json.name }},</h2>\n  <p>danke für deine Nachricht — die ist bei mir angekommen.</p>\n  <p>Ich schau mir dein Anliegen in Ruhe an und melde mich innerhalb der nächsten 24 Stunden per E-Mail. Falls es dringend ist, erreichst du mich auch direkt unter <a href=\"mailto:info@primaflow.de\">info@primaflow.de</a>.</p>\n  <p style=\"margin-top:32px\">Viele Grüße<br><b>Roman</b><br><span style=\"color:#666\">primaflow</span></p>\n  <hr style=\"margin:32px 0;border:none;border-top:1px solid #eee\">\n  <p style=\"color:#999;font-size:12px;margin:0\">Das ist eine automatische Bestätigung. Bitte nicht auf diese Mail antworten — ich melde mich persönlich.</p>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "primaflow-smtp",
          "name": "Primaflow SMTP"
        }
      }
    }
  ],
  "connections": {
    "Primaflow Webhook": {
      "main": [[{ "node": "Normalisieren", "type": "main", "index": 0 }]]
    },
    "Normalisieren": {
      "main": [[{ "node": "Postgres: Insert Lead", "type": "main", "index": 0 }]]
    },
    "Postgres: Insert Lead": {
      "main": [
        [
          { "node": "Mail an primaflow", "type": "main", "index": 0 },
          { "node": "Auto-Reply an Absender", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "1.0.0",
  "triggerCount": 1,
  "tags": [
    { "name": "primaflow" },
    { "name": "lead" }
  ]
}
